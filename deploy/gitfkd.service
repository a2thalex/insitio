[Unit]
Description=GitFkd git forge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gitfkd
Group=gitfkd
WorkingDirectory=/opt/gitfkd
# PORT, BASE_URL, DATA_DIR, TRUST_PROXY (written by setup.sh on first install)
EnvironmentFile=/etc/gitfkd.env
Environment=HOME=/var/lib/gitfkd NODE_ENV=production
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --import tsx src/main.ts
Restart=on-failure
RestartSec=3

# Hardening: the service can only write its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gitfkd
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
